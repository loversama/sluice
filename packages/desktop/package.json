{
  "name": "@sluice/desktop",
  "version": "0.4.4",
  "private": true,
  "description": "Windows desktop build: the same daemon and dashboard, without Docker.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --win --publish never",
    "dist": "npm run build && electron-builder --win --publish always",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@sluice/core": "*",
    "@sluice/server": "*",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-vite": "^4.0.0",
    "vite": "^7.1.5",
    "electron-builder": "^26.0.12"
  }
}
