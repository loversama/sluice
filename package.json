{
  "name": "twitch-drops-bot",
  "version": "0.1.0",
  "description": "Browserless Twitch drops miner.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check-hashes": "node dist/tools/check-hashes.js"
  },
  "dependencies": {
    "undici": "^7.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
