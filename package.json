{
  "name": "sluice",
  "version": "0.4.13",
  "description": "Sluice - a browserless Twitch drops miner that catches what flows past.",
  "type": "module",
  "main": "packages/daemon/dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "start": "node packages/daemon/dist/index.js",
    "typecheck": "tsc -b --noEmit || tsc -b",
    "check-hashes": "node packages/core/dist/tools/check-hashes.js",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "dev:web": "npm --prefix web run dev",
    "start:web": "node packages/daemon/dist/index.js --web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "undici": "^7.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
